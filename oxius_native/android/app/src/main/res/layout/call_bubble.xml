<?xml version="1.0" encoding="utf-8"?>
<!-- The floating call bubble shown over other apps. Kept deliberately small:
     it has to sit on someone else's screen without getting in the way, and its
     only job is to say a call is live and take one tap to get back to it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/bubble_root"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_call_bubble"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_call_notification" />

        <Chronometer
            android:id="@+id/bubble_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubble_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
