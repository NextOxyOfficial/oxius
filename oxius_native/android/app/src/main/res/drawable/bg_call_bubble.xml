<!-- Backing circle for the floating call bubble. Same navy gradient as the
     in-app minimised call bar, so the two read as one feature. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:startColor="#FF06223B"
        android:endColor="#FF0F3A63"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#8060A5FA" />
</shape>
